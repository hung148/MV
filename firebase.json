{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/ssr",
    "predeploy": ["npm run build", "npm test"],
    "headers": [
      { "source": "/site/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "function": { "functionId": "ssrSite", "region": "us-central1", "pinTag": true }
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "mv-web-35fcc",
          "appId": "1:997330990310:android:d6b7ec16123d19c567f727",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "mv-web-35fcc",
          "configurations": {
            "android": "1:997330990310:android:d6b7ec16123d19c567f727",
            "ios": "1:997330990310:ios:e0765bc8a4c71dec67f727",
            "macos": "1:997330990310:ios:e0765bc8a4c71dec67f727",
            "web": "1:997330990310:web:55926a158ca0f0c167f727",
            "windows": "1:997330990310:web:33342d6e8806801867f727"
          }
        }
      }
    }
  },
  "functions": [
    {
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ],
      "source": "functions"
    }
  ]
}
